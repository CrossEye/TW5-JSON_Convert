title: $:/plugins/crosseye/json-convert/ui/audit-log
type: text/vnd.tiddlywiki

\parameters (audit-title)
<$list filter="[<audit-title>has[list]]" emptyMessage="" variable="_jc">

!! Imported this session

<$count filter="[list<audit-title>]"/> tiddlers written to the wiki since this session was loaded.  Click a title to view; click ''Clear log'' to forget (the wiki contents are not affected).

<ul class="jc-audit-list">
<$list filter="[list<audit-title>]" variable="t">
<li><$link to=<<t>>><$text text=<<t>>/></$link></li>
</$list>
</ul>

<$button>
Clear log
<$action-deletetiddler $tiddler=<<audit-title>>/>
</$button>

</$list>
