title: $:/plugins/crosseye/json-convert/ui/results
type: text/vnd.tiddlywiki

\parameters (state-base, staged-base)

\procedure jc-result-items(json-title)
<ul>
<$list filter="[<json-title>get[text]jsonindexes[]]" variable="idx">
<li>''<$text text={{{ [<json-title>get[text]jsonget<idx>,[code]] }}}/>'' — <$text text={{{ [<json-title>get[text]jsonget<idx>,[message]] }}}/></li>
</$list>
</ul>
\end

<$let
  errors-title={{{ [<state-base>addsuffix[/result/errors]] }}}
  warnings-title={{{ [<state-base>addsuffix[/result/warnings]] }}}
  collisions-title={{{ [<state-base>addsuffix[/result/collisions]] }}}
  staged-prefix={{{ [<staged-base>addsuffix[/]] }}}
>

!! Results

<$list filter="[<errors-title>has[title]]" emptyMessage="//No run yet — click ''Convert'' above.//" variable="ignore">

|!Category |!Count |
|Tiddlers staged |<$count filter="[prefix<staged-prefix>]"/> |
|Errors |<$count filter="[<errors-title>get[text]jsonindexes[]]"/> |
|Warnings |<$count filter="[<warnings-title>get[text]jsonindexes[]]"/> |
|Collisions |<$count filter="[<collisions-title>get[text]jsonindexes[]]"/> |

<$list filter="[<errors-title>get[text]jsonindexes[]first[]]" emptyMessage="" variable="_first">
<details open><summary>Errors (<$count filter="[<errors-title>get[text]jsonindexes[]]"/>)</summary>
<$transclude $variable="jc-result-items" json-title=<<errors-title>>/>
</details>
</$list>

<$list filter="[<warnings-title>get[text]jsonindexes[]first[]]" emptyMessage="" variable="_first">
<details><summary>Warnings (<$count filter="[<warnings-title>get[text]jsonindexes[]]"/>)</summary>
<$transclude $variable="jc-result-items" json-title=<<warnings-title>>/>
</details>
</$list>

<$list filter="[<collisions-title>get[text]jsonindexes[]first[]]" emptyMessage="" variable="_first">
<details><summary>Collisions with existing titles (<$count filter="[<collisions-title>get[text]jsonindexes[]]"/>)</summary>
<ul>
<$list filter="[<collisions-title>get[text]jsonindexes[]]" variable="idx">
<li><$link to={{{ [<collisions-title>get[text]jsonget<idx>] }}}/></li>
</$list>
</ul>
</details>
</$list>

</$list>

</$let>
