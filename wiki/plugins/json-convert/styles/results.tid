title: $:/plugins/crosseye/json-convert/styles/results
tags: $:/tags/Stylesheet
type: text/css

.jc-result-nothing,
.jc-result-missing-title,
.jc-result-shape,
.jc-result-escape {
	margin: 0.6em 0;
	padding: 0.5em 0.8em;
	border-radius: 3px;
	border-left: 4px solid;
}

.jc-result-nothing,
.jc-result-missing-title {
	border-color: #b53a3a;
	background: rgba(181, 58, 58, 0.09);
}

.jc-result-shape {
	border-color: #c08a2e;
	background: rgba(192, 138, 46, 0.11);
}

.jc-result-shape ul {
	margin: 0.4em 0 0 0;
}

.jc-result-escape {
	border-color: #4a7fb5;
	background: rgba(74, 127, 181, 0.10);
}
