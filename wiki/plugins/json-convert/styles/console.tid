title: $:/plugins/crosseye/json-convert/styles/console
tags: $:/tags/Stylesheet
type: text/css

.jc-profile-header {
	display: grid;
	grid-template-columns: max-content max-content;
	column-gap: 0.5em;
	row-gap: 0.4em;
	align-items: baseline;
	justify-content: start;
	margin: 1em 0 0.5em 0;
}

.jc-profile-h     { grid-column: 1; grid-row: 1; }
.jc-profile-new   { grid-column: 2; grid-row: 1; }
.jc-profile-select{ grid-column: 1; grid-row: 2; }
.jc-profile-edit  { grid-column: 2; grid-row: 2; }

.jc-profile-h h2 {
	margin: 0;
	border: 0;
}

.jc-source-status:empty {
	display: none;
}

.jc-source-ok,
.jc-source-warn,
.jc-source-err,
.jc-source-note {
	margin: 0.4em 0 0 0;
	padding: 0.4em 0.7em;
	border-radius: 3px;
	border-left: 4px solid;
}

.jc-source-ok {
	border-color: #4a934a;
	background: rgba(74, 147, 74, 0.09);
}

.jc-source-warn {
	border-color: #c08a2e;
	background: rgba(192, 138, 46, 0.11);
}

.jc-source-note {
	border-color: #4a7fb5;
	background: rgba(74, 127, 181, 0.10);
}

.jc-source-err {
	border-color: #b53a3a;
	background: rgba(181, 58, 58, 0.09);
}

.jc-source-err-heading {
	font-weight: bold;
}

.jc-source-err-excerpt {
	margin: 0.4em 0;
	padding: 0.4em 0.6em;
	overflow-x: auto;
	white-space: pre;
	font-family: monospace;
	font-size: 0.85em;
	line-height: 1.3;
	background: rgba(0, 0, 0, 0.06);
	border: none;
}

.jc-source-err-hint {
	font-size: 0.9em;
	opacity: 0.85;
}

.jc-profile-normalize {
	margin: 0 0 1em 0;
}

.jc-profile-normalize label {
	display: inline-flex;
	align-items: baseline;
}

.jc-profile-normalize-hint {
	margin: 0.15em 0 0 1.9em;
	max-width: 46em;
	opacity: 0.8;
}

.jc-audit-list {
	max-height: 14em;
	overflow-y: auto;
	padding-left: 1.4em;
	margin: 0.5em 0;
}

.jc-audit-list li {
	font-family: monospace;
	font-size: 0.9em;
}
