icon: $:/plugins/crosseye/json-convert/icon
modified: 20260506120911486
title: $:/plugins/crosseye/json-convert-studio/Console
type: text/vnd.tiddlywiki

<$let
  state-base="$:/temp/json-convert/console"
  staged-base="$:/temp/json-convert/console/staged"
  source-title="$:/state/json-convert/source"
  profile-title="$:/state/json-convert/profile"
  note-title="$:/temp/json-convert/console/source-note"
  audit-title="$:/temp/json-convert/console/audit-log"
>

A general-purpose JSON-to-tiddler conversion tool. Paste your source JSON,
pick a profile, and click ''Convert''.

!! 1. Source JSON

<$transclude
  $tiddler="$:/plugins/crosseye/json-convert/ui/source"
  $mode="block"
  source-title=<<source-title>>
  note-title=<<note-title>>
  profile-title=<<profile-title>>/>

<div class="jc-profile-header">

<div class="jc-profile-h">

!! 2. Profile

</div>

<div class="jc-profile-new">
<$button>
New…
<$action-setfield $tiddler="$:/state/json-convert/console/new-profile-name" text=""/>
<$action-sendmessage
  $message="tm-modal"
  $param="$:/plugins/crosseye/json-convert-studio/NewProfileModal"/>
</$button>
</div>

<div class="jc-profile-select">
<$select tiddler=<<profile-title>>>
<option value="">— select a profile —</option>
<$list filter="[all[shadows+tiddlers]tag[$:/tags/json-convert/profile]sort[]]">
<option value=<<currentTiddler>>><$transclude $field="caption"><$view field="title"/></$transclude></option>
</$list>
</$select>
</div>

<div class="jc-profile-edit">
<$button
  disabled={{{ [<profile-title>get[text]!match[]has[title]then[no]else[yes]] }}}
  tooltip={{{ [<profile-title>get[text]!match[]has[title]then[Open the selected profile in the form-based editor]else[Select a profile first]] }}}>
Edit
<$action-setfield $tiddler="$:/state/json-convert/editor/profile-title" text={{{ [<profile-title>get[text]] }}}/>
<$json-convert-editor-init profile-title={{{ [<profile-title>get[text]] }}} draft-base="$:/state/json-convert/editor/draft/"/>
<$action-navigate $to="$:/plugins/crosseye/json-convert-studio/Editor"/>
</$button>
</div>

<div class="jc-profile-generate">
<$button
  disabled={{{ [<profile-title>get[text]!match[]has[title]then[no]else[yes]] }}}
  tooltip={{{ [<profile-title>get[text]!match[]has[title]then[Generate an importer plugin with this profile baked in]else[Select a profile first]] }}}>
Generate importer…
<$json-convert-generator-init profile={{{ [<profile-title>get[text]] }}} form-base="$:/state/json-convert/generator/" output-base="$:/temp/json-convert/generator/"/>
<$action-navigate $to="$:/plugins/crosseye/json-convert-studio/Generator"/>
</$button>
</div>

</div>

<$let selected-profile={{{ [<profile-title>get[text]] }}}>
<$list filter="[<selected-profile>!match[]has[title]]" variable="_jc" emptyMessage="">
<div class="jc-profile-normalize">
<$checkbox
  tiddler=<<selected-profile>>
  filter="[<selected-profile>jc-normalize-enabled[]]"
  checked="yes"
  unchecked="no"
  checkactions="<$json-convert-normalize-set profile-title=<<selected-profile>> enabled='yes'/>"
  uncheckactions="<$json-convert-normalize-set profile-title=<<selected-profile>> enabled='no'/>">
&nbsp;Flatten key/value pair arrays
</$checkbox>
<div class="jc-profile-normalize-hint"><small>Tick this when the source reports every field as its own `{"key": …, "value": …}` object instead of as a plain key/value pair.  The setting is saved with the profile.</small></div>
</div>
</$list>
</$let>

!! 3. Run

<$transclude
  $tiddler="$:/plugins/crosseye/json-convert/ui/convert-button"
  $mode="block"
  state-base=<<state-base>>
  staged-base=<<staged-base>>
  source-title=<<source-title>>
  profile={{{ [<profile-title>get[text]] }}}/>

<$transclude
  $tiddler="$:/plugins/crosseye/json-convert/ui/results"
  $mode="block"
  state-base=<<state-base>>
  staged-base=<<staged-base>>/>

<$transclude
  $tiddler="$:/plugins/crosseye/json-convert/ui/staging"
  $mode="block"
  state-base=<<state-base>>
  staged-base=<<staged-base>>
  audit-title=<<audit-title>>/>

<$transclude
  $tiddler="$:/plugins/crosseye/json-convert/ui/audit-log"
  $mode="block"
  audit-title=<<audit-title>>/>

</$let>
