title: $:/plugins/crosseye/json-convert-studio/styles/console
tags: $:/tags/Stylesheet
type: text/css

.jc-profile-header {
	display: grid;
	grid-template-columns: max-content max-content max-content;
	column-gap: 0.5em;
	row-gap: 0.4em;
	align-items: baseline;
	justify-content: start;
	margin: 1em 0 0.5em 0;
}

.jc-profile-h     { grid-column: 1; grid-row: 1; }
.jc-profile-new   { grid-column: 2; grid-row: 1; }
.jc-profile-select{ grid-column: 1; grid-row: 2; }
.jc-profile-edit  { grid-column: 2; grid-row: 2; }
.jc-profile-generate { grid-column: 3; grid-row: 2; }

.jc-profile-h h2 {
	margin: 0;
	border: 0;
}

.jc-profile-normalize {
	margin: 0 0 1em 0;
}

.jc-profile-normalize label {
	display: inline-flex;
	align-items: baseline;
}

.jc-profile-normalize-hint {
	margin: 0.15em 0 0 1.9em;
	max-width: 46em;
	opacity: 0.8;
}
